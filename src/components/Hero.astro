---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import AiBadge from './AiBadge.astro';
import { hero, company } from '../data/site';

const [numA, numB] = company.phoneDisplay.split(' ');
---

<section class="hero on-dark" id="top" aria-labelledby="hero-title">
  <svg class="hero__arcs" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
    <path d="M60 300a240 240 0 0 1 360-208" fill="none" stroke="var(--primary-light)" stroke-opacity="0.55" stroke-width="14" stroke-linecap="round" />
    <path d="M540 300a240 240 0 0 1-120 208" fill="none" stroke="#C9CDD2" stroke-opacity="0.35" stroke-width="14" stroke-linecap="round" />
  </svg>

  <div class="container hero__inner">
    <div class="hero__content">
      <span class="label hero__label" data-reveal>{hero.label}</span>
      <h1 id="hero-title" data-reveal style="--i:1">{hero.title}</h1>
      <p class="hero__intro" data-reveal style="--i:2">{hero.intro}</p>

      <div class="hero__call">
        <p class="hero__call-label" data-reveal style="--i:3">{hero.callLabel}</p>
        <a class="hero__number" href={company.phoneHref} aria-label={`Jetzt anrufen: ${company.phoneDisplay}`} data-monument>
          <span>{numA}</span> <span>{numB}</span>
        </a>
        <div class="btn-row hero__actions" data-reveal style="--i:4">
          <a class="btn btn--sos" href={company.phoneHref}><Icon name="phone" /><span>Jetzt anrufen</span></a>
          <a class="btn btn--whatsapp" href={company.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" /><span>WhatsApp schreiben</span></a>
        </div>
      </div>
    </div>

    <!-- Desktop: gerahmtes Bild rechts · Mobil/Tablet: Hintergrundbild mit Overlay -->
    <figure class="hero__visual">
      <Image
        src={hero.image}
        alt={hero.imageAlt}
        widths={[640, 960, 1280, 1800]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        loading="eager"
        fetchpriority="high"
        format="webp"
        class="hero__img"
      />
      <AiBadge position="bottom-right" class="hero__badge hero__badge--desktop" />
    </figure>
  </div>
  <AiBadge position="bottom-right" class="hero__badge hero__badge--mobile" />
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--dark);
    color: #fff;
  }
  .hero__arcs {
    position: absolute;
    z-index: -1;
    width: 620px;
    right: -8%;
    top: -14%;
    pointer-events: none;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: clamp(48px, 8vw, 88px);
    padding-bottom: clamp(48px, 7vw, 72px);
  }
  /* Nummer skaliert mit der Spaltenbreite statt mit dem Viewport */
  .hero__content { container-type: inline-size; }

  .hero h1 {
    margin-top: 1rem;
    color: #fff;
    font-weight: 800;
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .hero__intro {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
    max-width: 34rem;
  }

  .hero__call {
    margin-top: 2.25rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .hero__call-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--primary-tint);
  }
  .hero__number {
    display: block;
    margin: 0.35rem 0 1.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    /* „0157 77320888“ ist ca. 8,1em breit → passt in die Spalte */
    font-size: min(11.8cqi, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    transform-origin: left bottom;
    font-variant-numeric: tabular-nums;
  }
  .hero__number span { display: inline-block; transition: color 0.25s var(--ease); }
  .hero__number span:last-child { color: var(--primary-light); }
  .hero__number:hover span:first-child { color: var(--primary-tint); }
  .hero__number:hover span:last-child { color: #fff; }
  .hero__number:focus-visible { outline-offset: 8px; }

  /* Mobil & Tablet: Bild als ruhiger Hintergrund */
  .hero__visual {
    position: absolute;
    inset: 0;
    z-index: -2;
    margin: 0;
  }
  .hero__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(18, 38, 58, 0.86);
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
  }
  .hero :global(.hero__badge--desktop) { display: none; }

  @media (max-width: 1279px) {
    .hero__arcs { display: none; }
  }

  @media (max-width: 599px) {
    .hero__label { display: none; }
    .hero__call { margin-top: 1.75rem; padding-top: 1.5rem; }
    /* Nummer zweizeilig, „77320888“ ist ca. 5,2em breit */
    .hero__number span { display: block; }
    .hero__number { font-size: 18cqi; }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(3rem, 5vw, 5rem);
      align-items: center;
      padding-block: 80px;
    }
    .hero__visual {
      position: relative;
      inset: auto;
      z-index: auto;
      aspect-ratio: 4 / 5;
      max-height: 600px;
      width: 100%;
      justify-self: end;
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08);
    }
    .hero__visual::after {
      background: linear-gradient(180deg, rgba(14, 40, 66, 0) 55%, rgba(14, 40, 66, 0.35) 100%);
    }
    .hero :global(.hero__badge--desktop) { display: grid; }
    .hero :global(.hero__badge--mobile) { display: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__number {
        animation: monument linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      @keyframes monument {
        to { transform: scale(0.93); opacity: 0.55; }
      }
    }
  }
</style>
