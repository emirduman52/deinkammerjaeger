---
import Icon from './Icon.astro';
import { trustItems } from '../data/site';
---

<section class="trust" aria-label="Darauf können Sie sich verlassen">
  <ul class="container trust__list">
    {trustItems.map((item, i) => (
      <li class="trust__item" data-reveal style={`--i:${i}`}>
        <span class="icon-badge"><Icon name={item.icon} /></span>
        <span class="trust__text">{item.text}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .trust {
    background: var(--bg-soft);
  }
  .trust__list {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 1rem;
    padding-block: 1.75rem;
  }
  .trust__item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .trust__text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  @media (max-width: 599px) {
    .trust__item { gap: 0.75rem; }
    .trust__item :global(.icon-badge) { width: 2.5rem; height: 2.5rem; }
    .trust__item :global(.icon-badge .icon) { width: 1.15rem; height: 1.15rem; }
    .trust__text { font-size: 0.9375rem; }
  }
  @media (min-width: 600px) {
    .trust__list { gap: 1.5rem 2rem; }
  }
  @media (min-width: 1024px) {
    .trust__list { grid-template-columns: repeat(4, 1fr); padding-block: 2.25rem; }
  }
</style>
