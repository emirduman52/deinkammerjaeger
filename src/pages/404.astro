---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';
---

<BaseLayout title="Seite nicht gefunden | deinkammerjaeger" description="Diese Seite wurde nicht gefunden." noindex>
  <section class="nf on-dark">
    <div class="container nf__inner">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>Diese Seite ist uns entwischt</h1>
      <p class="nf__text">Die gesuchte Seite gibt es nicht (mehr). Ihr Schädlingsproblem lösen wir trotzdem – direkt am Telefon oder über die Startseite.</p>
      <div class="btn-row">
        <a class="btn btn--sos" href={company.phoneHref}><Icon name="phone" /><span>{company.phoneDisplay}</span></a>
        <a class="btn btn--outline-light" href={withBase('/')}><Icon name="house" /><span>Zur Startseite</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    background: var(--dark);
    color: #fff;
    min-height: 72svh;
    display: grid;
    align-items: center;
    padding-block: 80px;
  }
  .nf__code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(6rem, 26vw, 16rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--primary-light);
  }
  .nf h1 { color: #fff; font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem); font-weight: 800; margin-top: 1.5rem; }
  .nf__text { margin: 1rem 0 2rem; max-width: 36rem; font-size: 1.125rem; color: rgba(255, 255, 255, 0.88); }
</style>
